/* VIBE-CODER — Codex-style monochrome. */

Screen { background: #0c0c0d; color: #c8c8c8; }

#topbar {
  height: 1; padding: 0 1;
  background: #0c0c0d; color: #6f6f6f;
}
#topbar #title { content-align: left middle; color: #6f6f6f; }
#topbar #meta  { content-align: right middle; color: #4a4a4a; }

#banner    { height: auto; padding: 1 2 0 2; color: #d0a875; background: #0c0c0d; }
#banner-tag{ height: 1; padding: 0 2 1 2; color: #6f6f6f; background: #0c0c0d; }

#chat { height: 1fr; padding: 0 2; background: #0c0c0d; }

ChatLog { height: 1fr; scrollbar-size: 1 1; background: #0c0c0d; }
ChatLog .chat-user      { color: #e6e6e6; }
ChatLog .chat-think     { color: #707070; }
ChatLog .chat-tool      { color: #9a9a9a; }
ChatLog .chat-tool-ok   { color: #7ea877; }
ChatLog .chat-tool-err  { color: #c46060; }
ChatLog .chat-output    { color: #d0a875; }
ChatLog .chat-error     { color: #c46060; }
ChatLog .chat-validator { color: #8a8a8a; }
ChatLog .chat-memory    { color: #8a8a8a; }

#thinking-row { height: 1; padding: 0 2; display: none; }
#thinking-row.visible { display: block; }
ThinkingBubble { width: auto; height: 1; }
ThinkingBubble #dot  { color: #707070; padding-right: 1; }
ThinkingBubble #verb { color: #707070; }

/* Input row — single line, thin rule above. NO height override on InputBox. */
#input-row {
  height: 3;
  padding: 0 2;
  background: #0c0c0d;
  border-top: heavy #1c1c1c;
}

Input {
  border: none;
  background: #0c0c0d;
  color: #e6e6e6;
  padding: 0;
}
Input:focus { background: #0c0c0d; }

#status-bar { height: 1; padding: 0 2; background: #0c0c0d; color: #4a4a4a; }
