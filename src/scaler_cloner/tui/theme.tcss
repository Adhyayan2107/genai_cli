/* Scaler Cloner — Textual theme.

Layout strategy:
  - root is a `Vertical` of three regions: Header bar, ChatLog (1fr), input area.
  - Everything sizes in `fr` and `auto` so terminal resize reflows automatically.
  - Min terminal we target: 80x24. At <80 cols, the status bar collapses.

Color palette (matches Scaler-ish brand + Claude Code orange for the pulse):
  $accent-orange = #FF6B1A
  $accent-orange-soft = #FFA559
*/

Screen {
  background: $surface;
  color: $text;
  layers: base overlay;
}

#topbar {
  height: 1;
  padding: 0 1;
  background: $boost;
  color: $text-muted;
}

#topbar #title { content-align: left middle; }
#topbar #meta  { content-align: right middle; color: $text-muted; }

#chat {
  height: 1fr;
  padding: 1 2;
  border: none;
  background: $surface;
}

ChatLog {
  height: 1fr;
  scrollbar-size: 1 1;
  background: $surface;
}

ChatLog .chat-user        { color: $accent; text-style: bold; }
ChatLog .chat-think       { color: $text-muted; }
ChatLog .chat-tool        { color: #FFA559; }
ChatLog .chat-tool-ok     { color: #2ECC71; }
ChatLog .chat-tool-err    { color: #FF5C5C; }
ChatLog .chat-output      { color: #2ECC71; text-style: bold; }
ChatLog .chat-error       { color: #FF5C5C; text-style: bold; }
ChatLog .chat-validator   { color: #B19CD9; text-style: italic; }
ChatLog .chat-memory      { color: #C792EA; }

#thinking-row {
  height: 1;
  padding: 0 2;
  display: none;
}

#thinking-row.visible { display: block; }

ThinkingBubble {
  width: auto;
  height: 1;
}

ThinkingBubble #dot   { color: #FF6B1A; text-style: bold; padding-right: 1; }
ThinkingBubble #verb  { color: $text-muted; text-style: italic; }

#input-row {
  height: auto;
  padding: 1 2 1 2;
  background: $surface;
}

InputBox {
  height: 3;
  border: round #FF6B1A;
  background: $surface;
  padding: 0 1;
}

InputBox:focus-within { border: round #FFA559; }

InputBox > Input {
  border: none;
  background: $surface;
  padding: 0;
}

#status-bar {
  height: 1;
  padding: 0 2;
  background: $boost;
  color: $text-muted;
}

#status-bar .ok    { color: #2ECC71; }
#status-bar .warn  { color: #FFA559; }
#status-bar .err   { color: #FF5C5C; }
